    "@astrojs/sitemap": "3.7.4",
    "@astrojs/vercel": "11.0.16",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "lucide-react": "1.61.0",
    "lucide-static": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pagefind": "1.5.2",
