{
  "name": "stay-prepped",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stay Prepped: practical emergency-preparedness guides and free in-browser tools.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/postbuild.mjs",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "astro check",
    "linkcheck": "node scripts/check-links.mjs && node scripts/check-ids.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@astrojs/check": "0.9.4",
    "@astrojs/mdx": "4.3.14",
    "@astrojs/react": "4.4.2",
    "@astrojs/sitemap": "3.6.0",
    "@astrojs/vercel": "8.2.11",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "5.18.2",
    "lucide-react": "1.61.0",
    "lucide-static": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pagefind": "1.5.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
