# Canonical site URL (no trailing slash). Required before going live.
SITE_URL=https://stayprepped.co.uk

# Newsletter (optional). Without RESEND_API_KEY the sign-up form tells people it is not live yet.
RESEND_API_KEY=
RESEND_SEGMENT_ID=

# Contact form (optional). Needs RESEND_API_KEY plus both of these.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Shown as a mailto link on /contact when the form is not configured.
PUBLIC_CONTACT_EMAIL=updates@stayprepped.co.uk

# Cookieless analytics: set to "vercel" to enable Vercel Web Analytics,
# or "plausible" together with PUBLIC_PLAUSIBLE_DOMAIN.
PUBLIC_ANALYTICS=
PUBLIC_PLAUSIBLE_DOMAIN=

# AdSlot component renders nothing unless this is "true".
PUBLIC_ADS_ENABLED=
