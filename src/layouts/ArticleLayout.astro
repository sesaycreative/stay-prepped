---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import TableOfContents from '../components/TableOfContents.astro';
import LastReviewed from '../components/LastReviewed.astro';
import type { Crumb } from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import Illustration from '../components/illustrations/Illustration.astro';
import { SITE, type IllustrationKey, type Tone } from '../lib/site';
import { absolute, articleLd } from '../lib/seo';
import { sectionNumbering } from '../lib/rehype-stayprepped.mjs';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  publishedAt: Date;
  reviewedAt: Date;
  headings: MarkdownHeading[];
  breadcrumbs: Crumb[];
  sources: { title: string; url: string; publisher: string }[];
  tone?: Tone;
  art?: IllustrationKey;
  inShort?: string[];
}
const { title, description, eyebrow, publishedAt, reviewedAt, headings, breadcrumbs, sources, tone = 'neutral', art, inShort } = Astro.props;
const url = absolute(Astro.url.pathname, Astro.site);
const ld = [articleLd({ title, description, url, published: publishedAt, modified: reviewedAt, site: Astro.site })];
const tocHeadings = headings;
const { numbered } = sectionNumbering(headings.filter((h) => h.depth === 2).map((h) => h.text));
---
<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} jsonLd={ld} ogType="article" footerNewsletter={false}>
  <article class={`tone-${tone}`}>
    <div class="article-band">
      <header class="wrap article-head">
        <div class="article-head-copy">
          {eyebrow && <p class="card-label article-eyebrow">{eyebrow}</p>}
          <h1>{title}</h1>
          <p class="lede">{description}</p>
          <div class="article-meta">
            <span>By {SITE.author}</span>
            <LastReviewed date={reviewedAt} published={publishedAt} />
          </div>
        </div>
        {art && <div class="article-art"><Illustration name={art} width={200} /></div>}
      </header>
    </div>
    <div class="wrap">
    <div class="article-grid">
      <aside class="article-aside"><TableOfContents headings={tocHeadings} numbered={numbered} /></aside>
      <div class="article-main">
        {inShort && (
          <aside class="in-short article-in-short" aria-labelledby="in-short-title">
            <h2 id="in-short-title" class="in-short-title"><Icon name="zap" size={18} /> In short</h2>
            <ul>{inShort.map((b) => <li>{b}</li>)}</ul>
          </aside>
        )}
        <div class="prose article-body" data-article-body>
          <slot />
        </div>
        <slot name="after" />
        <div class="article-signup no-print">
          <NewsletterForm
            idPrefix="article-newsletter"
            variant="card"
            heading="Found this useful?"
            lede="Get the next guide by email — one short message when we publish something new."
          />
        </div>
        {sources.length > 0 && (
          <footer class="sources-note" aria-labelledby="sources">
            <h2 id="sources">Sources and further reading</h2>
            <ol>
              {sources.map((s) => (
                <li><a href={s.url} rel="noopener">{s.title}</a> <span>({s.publisher})</span></li>
              ))}
            </ol>
          </footer>
        )}
      </div>
    </div>
    </div>
  </article>
</BaseLayout>
<style>
  .article-band { background: var(--t-band); border-bottom: 1px solid var(--t-border); margin-top: 1rem; }
  .article-head { padding-block: 2rem 2.25rem; display: flex; gap: 2rem; align-items: center; justify-content: space-between; }
  .article-head-copy { display: grid; gap: 0.75rem; max-width: 46rem; }
  .article-art { display: none; flex-shrink: 0; }
  .article-art :global(.ill) { --ill-bg: var(--t-surface); }
  @media (min-width: 760px) { .article-art { display: block; } }
  .lede { font-size: 1.2rem; line-height: 1.55; }
  .article-meta { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; color: var(--text-muted); font-size: 0.92rem; align-items: center; }
  .in-short { max-width: 46rem; margin-bottom: 1.75rem; }
  .article-grid { display: grid; gap: 0; margin-top: 1.75rem; }
  @media (min-width: 1000px) {
    .article-grid { grid-template-columns: 15rem minmax(0, 1fr); gap: 3.5rem; }
    .article-aside { order: 0; }
    .article-aside :global(.toc) { position: sticky; top: 6rem; }
  }
  .article-signup { margin-top: 3.5rem; }
  .sources-note { margin-top: 3.5rem; padding-top: 1rem; border-top: 1px solid var(--rule); max-width: 62ch; font-size: 0.88rem; color: var(--text-muted); }
  .sources-note h2 { font-family: var(--font-body); font-size: 0.92rem; font-weight: 700; color: var(--text-muted); letter-spacing: 0; }
  .sources-note ol { margin-top: 0.5rem; padding-left: 1.2rem; list-style: decimal; display: grid; gap: 0.3rem; }
  .sources-note a { color: var(--text); }
</style>
