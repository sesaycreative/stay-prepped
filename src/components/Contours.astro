---
// Decorative topographic contour lines, the site's one signature motif
// (Ordnance Survey map vernacular). Purely presentational.
interface Props { class?: string; rings?: number; cx?: number; cy?: number }
const { class: className = '', rings = 12, cx = 560, cy = 220 } = Astro.props;
const paths = Array.from({ length: rings }, (_, i) => {
  const r = 40 + i * 34;
  const wob = 0.12 + (i % 3) * 0.03;
  // Slightly irregular closed curve so it reads as terrain, not a target.
  const pts = Array.from({ length: 9 }, (_, k) => {
    const a = (k / 9) * Math.PI * 2;
    const rr = r * (1 + Math.sin(a * 3 + i * 0.7) * wob);
    return [cx + Math.cos(a) * rr * 1.25, cy + Math.sin(a) * rr * 0.8];
  });
  const d = pts
    .map((p, k) => {
      const n = pts[(k + 1) % pts.length];
      const mx = (p[0] + n[0]) / 2, my = (p[1] + n[1]) / 2;
      return `${k === 0 ? `M${mx.toFixed(1)},${my.toFixed(1)}` : ''} Q${n[0].toFixed(1)},${n[1].toFixed(1)} ${((n[0] + pts[(k + 2) % pts.length][0]) / 2).toFixed(1)},${((n[1] + pts[(k + 2) % pts.length][1]) / 2).toFixed(1)}`;
    })
    .join(' ');
  return { d, strong: i % 4 === 3 };
});
---
<svg class={`contours ${className}`} viewBox="0 0 900 440" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  {paths.map((p) => <path d={p.d} fill="none" stroke="currentColor" stroke-width={p.strong ? 1.6 : 1} vector-effect="non-scaling-stroke" />)}
</svg>
<style>
  .contours { color: var(--rule); width: 100%; height: 100%; display: block; }
</style>
