---
import Icon from './Icon.astro';
import Illustration from './illustrations/Illustration.astro';
import type { IllustrationKey, Tone } from '../lib/site';
interface Props { href: string; label: string; blurb: string; icon: string; count?: number; tone?: Tone; art?: IllustrationKey; headingLevel?: 'h2' | 'h3' | 'h4'; compact?: boolean }
const { href, label, blurb, icon, count, tone = 'neutral', art, headingLevel = 'h3', compact = false } = Astro.props;
const H = headingLevel;
---
<article class={`card is-link cat-card tone-${tone} ${compact ? 'is-compact' : ''}`}>
  {art ? <span class="card-art"><Illustration name={art} width={132} /></span> : <span class={`chip ${compact ? '' : 'chip-lg'}`}><Icon name={icon} size={compact ? 22 : 28} /></span>}
  <div class="cat-body">
    <H class="card-title"><a href={href} class="stretched">{label}</a></H>
    <p class="card-text">{blurb}</p>
    {typeof count === 'number' && count > 0 && <p class="card-label">{count} {count === 1 ? 'guide' : 'guides'}</p>}
  </div>
  {!compact && <span class="card-cta" aria-hidden="true">Explore <Icon name="arrow-right" size={18} /></span>}
</article>
<style>
  .cat-body { display: grid; gap: 0.3rem; }
  .is-compact { flex-direction: row; align-items: flex-start; gap: 0.85rem; padding: 1rem 1.1rem; }
  .is-compact .card-title { font-size: 1.05rem; }
  .is-compact .card-text { font-size: 0.92rem; }
</style>
