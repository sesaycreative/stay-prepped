---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import ComingSoonBadge from './ComingSoonBadge.astro';
import Illustration from './illustrations/Illustration.astro';
import { SLUG_ILLUSTRATION, TOOL_CATEGORY_TONE } from '../lib/site';
interface Props { tool: CollectionEntry<'tools'>; headingLevel?: 'h2' | 'h3' | 'h4'; art?: boolean }
const { tool, headingLevel = 'h3', art = false } = Astro.props;
const t = tool.data;
const live = t.status === 'live';
const H = headingLevel;
const ill = art ? SLUG_ILLUSTRATION[t.slug] : undefined;
const tone = live ? 'tools' : TOOL_CATEGORY_TONE[t.category];
---
{live ? (
  <article class={`card is-link tool-card tone-${tone}`}>
    {ill ? <span class="card-art"><Illustration name={ill} width={144} /></span> : <span class="chip chip-lg"><Icon name={t.icon} size={28} /></span>}
    <H class="card-title"><a href={`/tools/${t.slug}/`} class="stretched">{t.title}</a></H>
    <p class="card-text">{t.cardSummary ?? t.summary}</p>
    <span class="card-cta" aria-hidden="true">Open the tool <Icon name="arrow-right" size={18} /></span>
  </article>
) : (
  <article class={`card card-soon tool-card tone-${tone}`} aria-label={`${t.title} (coming soon)`}>
    <span class="chip"><Icon name={t.icon} size={22} /></span>
    <H class="card-title">{t.title}</H>
    <p class="card-text">{t.summary}</p>
    <span class="card-meta"><ComingSoonBadge /></span>
  </article>
)}
<style>
  .tool-card.is-link { border-width: 1.5px; }
  .card-soon .card-title { font-size: 1.05rem; }
</style>
