---
import Logo from './Logo.astro';
import { FOOTER_LEGAL, NAV, SITE } from '../lib/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <a href="/" class="brand"><Logo size={30} /><span>Stay Prepped</span></a>
      <p>{SITE.tagline}</p>
      <p class="footer-note">General guidance for UK households. In an emergency where life is at risk, call 999. For non-emergency medical help, call NHS 111. To report a power cut, call 105.</p>
    </div>
    <nav aria-label="Footer: site">
      <h2 class="footer-h">Explore</h2>
      <ul>{NAV.slice(1).map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </nav>
    <nav aria-label="Footer: legal">
      <h2 class="footer-h">About this site</h2>
      <ul>{FOOTER_LEGAL.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </nav>
  </div>
  <div class="wrap footer-base">
    <p>© {year} Precious Memories Ltd, trading as Stay Prepped. Our tools run in your browser; your answers stay on your device.</p>
    <p>Icons by <a href="https://lucide.dev" rel="noopener">Lucide</a> (ISC licence).</p>
  </div>
</footer>
<style>
  .site-footer { margin-top: 5rem; background: #23272a; color: #ece7dd; padding-block: 3rem 1.5rem; }
  .site-footer a { color: #ece7dd; }
  .footer-grid { display: grid; gap: 2rem; }
  @media (min-width: 760px) { .footer-grid { grid-template-columns: 1.4fr 1fr 1fr; } }
  .brand { display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; font-family: var(--font-head); font-weight: 700; font-size: 1.25rem; }
  .brand :global(.logo-mark path:first-child) { fill: #6fa67c; }
  .brand :global(.logo-mark path:last-child) { stroke: #23272a; }
  .footer-brand p { margin-top: 0.6rem; max-width: 26rem; }
  .footer-note { color: #c9c3b7; font-size: 0.93rem; }
  .footer-h { font-family: var(--font-body); font-size: 1rem; color: #c9b99b; margin-bottom: 0.6rem; }
  .site-footer ul { display: grid; gap: 0.35rem; }
  .footer-base { margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid #3a3f42; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem; font-size: 0.88rem; color: #c9c3b7; }
</style>
