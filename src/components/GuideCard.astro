---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import Illustration from './illustrations/Illustration.astro';
import { GUIDE_CATEGORIES, GUIDE_CATEGORY_TONE, SLUG_ILLUSTRATION } from '../lib/site';
interface Props { guide: CollectionEntry<'guides'>; headingLevel?: 'h2' | 'h3' | 'h4'; showCategory?: boolean; art?: boolean }
const { guide, headingLevel = 'h3', showCategory = true, art = true } = Astro.props;
const g = guide.data;
const H = headingLevel;
const cat = GUIDE_CATEGORIES[g.category];
const ill = art ? SLUG_ILLUSTRATION[guide.id] : undefined;
---
<article class={`card is-link guide-card tone-${GUIDE_CATEGORY_TONE[g.category]}`}>
  {ill ? <span class="card-art"><Illustration name={ill} width={132} /></span> : <span class="chip"><Icon name={cat.icon} size={22} /></span>}
  {showCategory && <p class="card-label">{cat.label}</p>}
  <H class="card-title"><a href={`/guides/${guide.id}/`} class="stretched">{g.title}</a></H>
  <p class="card-text">{g.description}</p>
  <span class="progress-chip" data-progress-lists={`guide/${guide.id}/`} hidden></span>
  <span class="card-cta" aria-hidden="true">Read the guide <Icon name="arrow-right" size={18} /></span>
</article>
