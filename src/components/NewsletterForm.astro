---
// Posts to /api/newsletter. The endpoint only subscribes people when
// RESEND_API_KEY is configured; otherwise it says plainly that sign-up is not
// live yet. Progressive enhancement: works without JavaScript too.
//
// Can appear more than once on a page: pass a unique `idPrefix` to each copy.
// Variants: "full" (homepage section), "footer" (single row on the dark
// footer), "card" (end of guides).
interface Props {
  idPrefix?: string;
  variant?: 'full' | 'footer' | 'card';
  /** Kept for the old API: compact = the card variant. */
  compact?: boolean;
  heading?: string;
  lede?: string;
  headingLevel?: 'h2' | 'h3';
}
const {
  idPrefix = 'newsletter',
  compact = false,
  variant = compact ? 'card' : 'full',
  heading = 'Get new guides and tools by email',
  lede,
  headingLevel = 'h2',
} = Astro.props;
const H = headingLevel;
const id = (s: string) => `${idPrefix}-${s}`;
const isFull = variant === 'full';
---
<section class={`newsletter is-${variant}`} aria-labelledby={id('title')}>
  <div class="newsletter-copy">
    <H id={id('title')} class="newsletter-h">{heading}</H>
    {isFull ? (
      <p>One short email when we publish something useful. No spam, and you can unsubscribe at any time. See our <a href="/privacy/">privacy policy</a>.</p>
    ) : lede ? <p>{lede}</p> : null}
  </div>
  <form method="post" action="/api/newsletter" class="newsletter-form" data-newsletter novalidate>
    <div class="field">
      <label class="field-label" for={id('email')}>Email address</label>
      <input id={id('email')} class="input" type="email" name="email" autocomplete="email" required maxlength="254" aria-describedby={isFull ? id('status') : `${id('privacy')} ${id('status')}`} />
    </div>
    <!-- Honeypot: humans leave this empty. -->
    <div class="sr-only" aria-hidden="true">
      <label for={id('website')}>Leave this field empty</label>
      <input id={id('website')} type="text" name="website" tabindex="-1" autocomplete="off" />
    </div>
    <button type="submit" class="btn btn-primary">Sign up</button>
    {!isFull && <p id={id('privacy')} class="newsletter-privacy">No spam. Unsubscribe at any time. <a href="/privacy/">Privacy policy</a>.</p>}
    <p id={id('status')} class="newsletter-status" role="status" aria-live="polite"></p>
  </form>
</section>
<script>
  document.querySelectorAll<HTMLFormElement>('form[data-newsletter]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = form.querySelector<HTMLElement>('.newsletter-status')!;
      const email = form.querySelector<HTMLInputElement>('input[name="email"]')!;
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      if (!email.value.trim() || !email.checkValidity()) {
        email.setAttribute('aria-invalid', 'true');
        status.textContent = 'Enter a valid email address, like name@example.com.';
        status.dataset.state = 'error';
        email.focus();
        return;
      }
      email.removeAttribute('aria-invalid');
      btn.disabled = true;
      status.textContent = 'Signing you up…';
      status.dataset.state = '';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const data = await res.json().catch(() => ({}));
        status.textContent = data.message ?? (res.ok ? 'Thanks, you are signed up.' : 'Sign-up failed. Please try again later.');
        status.dataset.state = res.ok && data.ok ? 'ok' : 'error';
        if (res.ok && data.ok) form.reset();
      } catch {
        status.textContent = 'We could not reach the server. Check your connection and try again.';
        status.dataset.state = 'error';
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
<style>
  .newsletter { display: grid; gap: 1.25rem; }
  .newsletter-copy p { margin-top: 0.4rem; max-width: 34rem; }
  .newsletter-form { display: grid; grid-template-columns: 1fr auto; gap: 0.6rem; align-items: end; }
  .newsletter-status { grid-column: 1 / -1; min-height: 1.4em; font-size: 0.95rem; }
  .newsletter-status:empty { min-height: 0; }
  .newsletter-status[data-state='error'] { color: var(--error); font-weight: 700; }
  .newsletter-status[data-state='ok'] { color: var(--primary); font-weight: 700; }
  .newsletter-privacy { grid-column: 1 / -1; font-size: 0.88rem; color: var(--text-muted); margin: 0; }
  @media (max-width: 480px) { .newsletter-form { grid-template-columns: 1fr; } }

  /* Full: homepage section. */
  .is-full { background: var(--surface-2); padding: 1.75rem 1.25rem; border-radius: var(--radius-m); }
  .is-full .newsletter-h { font-size: 1.5rem; }
  @media (min-width: 860px) { .is-full { grid-template-columns: 1.1fr 1fr; align-items: end; padding: 2.25rem; } }

  /* Card: end of guides. Neutral card surface, no area tint. */
  .is-card {
    background: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius-l);
    box-shadow: var(--shadow-card); padding: 1.5rem 1.25rem;
  }
  .is-card .newsletter-h { font-size: 1.35rem; margin: 0; }
  @media (min-width: 860px) { .is-card { grid-template-columns: 1fr 1.1fr; align-items: center; gap: 2rem; padding: 1.75rem 2rem; } }

  /* Footer: one row on the always-dark footer. Fixed colours to match it. */
  .is-footer { gap: 0.75rem; }
  .is-footer .newsletter-h { font-family: var(--font-body); font-size: 1rem; font-weight: 700; color: #c9b99b; margin: 0; }
  .is-footer .field-label { color: #ece7dd; }
  .is-footer .input { background: #1a1d1f; color: #ece7dd; border-color: #858a94; }
  .is-footer .btn-primary { background: #8fc29b; color: #1a1d1f; }
  .is-footer .btn-primary:hover { background: #a7d2b1; }
  .is-footer .newsletter-privacy { color: #c9c3b7; }
  .is-footer .newsletter-privacy a { color: #ece7dd; }
  .is-footer .newsletter-status[data-state='error'] { color: #f2b48a; }
  .is-footer .newsletter-status[data-state='ok'] { color: #8fc29b; }
  .is-footer :focus-visible { outline-color: #8fc29b; }
  @media (min-width: 860px) {
    .is-footer { grid-template-columns: minmax(12rem, 1fr) 2.2fr; align-items: center; gap: 1.5rem; }
    .is-footer .newsletter-form { grid-template-columns: minmax(0, 1fr) auto minmax(0, 1.1fr); }
    .is-footer .newsletter-privacy { grid-column: auto; align-self: center; }
  }
</style>
