---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import Icon from '../../components/Icon.astro';
import { TOOL_CATEGORIES, TOOL_CATEGORY_KEYS, TOOL_CATEGORY_TONE } from '../../lib/site';

const tools = (await getCollection('tools')).sort((a, b) => a.data.order - b.data.order);
const live = tools.filter((t) => t.data.status === 'live');
const groups = TOOL_CATEGORY_KEYS.map((key) => ({
  key,
  ...TOOL_CATEGORIES[key],
  tone: TOOL_CATEGORY_TONE[key],
  tools: tools.filter((t) => t.data.category === key && t.data.status !== 'live').sort((a, b) => a.data.order - b.data.order),
})).filter((g) => g.tools.length);
---
<BaseLayout
  title="Free prepper tools and calculators"
  description="Free emergency-preparedness calculators that run in your browser: food storage, water storage and a home preparedness score. No sign-up, nothing stored on our servers."
  breadcrumbs={[{ label: 'Free tools' }]}
>
  <div class="tone-tools">
    <div class="wrap">
      <header class="page-head">
        <h1>Free prepper tools</h1>
        <p>Free, no account, and your answers never leave your device.</p>
      </header>
    </div>
    <section class="band" aria-labelledby="live-title">
      <div class="wrap">
        <div class="band-head"><h2 id="live-title">Ready to use</h2></div>
        <div class="card-grid card-grid-fit">
          {live.map((t) => <ToolCard tool={t} art />)}
        </div>
      </div>
    </section>
  </div>

  <section class="band-plain" aria-labelledby="soon-title">
    <div class="wrap">
      <div class="band-head">
        <div>
          <h2 id="soon-title">Coming soon</h2>
          <p>We build one at a time and only publish a tool when it works properly.</p>
        </div>
      </div>
      {groups.map((g) => (
        <section aria-labelledby={`cat-${g.key}`} class={`soon-group tone-${g.tone}`}>
          <h3 id={`cat-${g.key}`} class="soon-title"><span class="chip"><Icon name={g.icon} size={20} /></span> {g.label}</h3>
          <div class="card-grid mt-3">
            {g.tools.map((t) => <ToolCard tool={t} headingLevel="h4" />)}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
<style>
  .soon-group + .soon-group { margin-top: 2.25rem; }
  .soon-title { display: flex; align-items: center; gap: 0.6rem; font-size: 1.2rem; }
  .soon-title .chip { width: 2.25rem; height: 2.25rem; border-radius: 0.75rem; }
</style>
