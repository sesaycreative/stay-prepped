---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="The page you were looking for could not be found." noindex searchable={false}>
  <div class="wrap py-12 measure">
    <h1>We could not find that page</h1>
    <p class="mt-4 text-lg">It may have moved, or the link may be wrong. Try one of these instead:</p>
    <ul class="mt-4 grid gap-2" style="list-style: disc; padding-left: 1.3rem">
      <li><a href="/">Home page</a></li>
      <li><a href="/start/">Start Prepping</a></li>
      <li><a href="/guides/">All guides</a></li>
      <li><a href="/tools/">Free tools</a></li>
    </ul>
    <p class="mt-6"><button type="button" class="btn btn-secondary" data-search-open>Search the site</button></p>
  </div>
</BaseLayout>
