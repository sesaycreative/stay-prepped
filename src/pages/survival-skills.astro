---
import HubLayout from '../layouts/HubLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
const skills = [
  { label: 'Making water safer to drink', blurb: 'Boiling, filters and tablets, and when not to drink water at all.', href: '/guides/emergency-water-purification/', icon: 'droplet', tone: 'water' as const },
  { label: 'Coping with a power cut', blurb: 'Light, warmth and food safety when the electricity goes off.', href: '/guides/preparing-for-a-power-cut/', icon: 'flashlight', tone: 'power' as const },
  { label: 'Planning as a household', blurb: 'Meeting places, contacts and who does what.', href: '/guides/family-emergency-plan/', icon: 'users', tone: 'home' as const },
  { label: 'Packing to leave quickly', blurb: 'What to carry, and how to keep the weight down.', href: '/guides/72-hour-emergency-bag/', icon: 'backpack', tone: 'kits' as const },
];
---
<HubLayout
  title="Survival Skills"
  seoTitle="Practical survival skills for everyday emergencies"
  description="Practical skills that help when normal services stop: making water safer, coping with power cuts, planning as a household and packing to leave quickly."
  intro="Calm, practical skills for coping at home when the power, water or phones stop working."
  tone="skills"
>
  <Fragment slot="why">
    <p>For most UK households, survival skills are less about the wilderness and more about coping calmly at home when normal services stop.</p>
    <p>Dedicated guides on first aid basics, safe emergency cooking and keeping warm are being written. We only publish guides once they have been carefully checked.</p>
  </Fragment>
  <section aria-labelledby="skills-title">
    <h2 id="skills-title" class="sr-only">Skills covered so far</h2>
    <div class="card-grid">
      {skills.map((s) => <CategoryCard {...s} />)}
    </div>
  </section>
</HubLayout>
