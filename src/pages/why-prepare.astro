---
// "Why prepare?" Built only from the GOV.UK Be Ready page and the National
// Risk Register 2025 publication page (both checked 24 October 2026). See
// src/data/risks.ts for the rules on adding to this page.
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Illustration from '../components/illustrations/Illustration.astro';
import { RISKS, BE_READY_CHECKLIST, BE_READY_URL, NRR_URL } from '../data/risks';
import { formatDate, isoDate } from '../lib/site';

const reviewed = new Date('2026-10-24');
const signUps = [
  { icon: 'heart-handshake', title: 'Priority Services Register', text: 'Free extra support from your energy and water companies during supply interruptions, if you are eligible. In Northern Ireland, ask about Customer Care Registers.', href: 'https://www.thepsr.co.uk/', link: 'Check if you can join' },
  { icon: 'phone', title: 'Power cut: 105', text: 'Write the number on paper. It works in England, Scotland and Wales; Northern Ireland uses 03457 643643. Call 999 if anyone is in immediate danger.', href: '/guides/preparing-for-a-power-cut/', link: 'Power cut guide' },
  { icon: 'bell-ring', title: 'Local alerts and warnings', text: 'Sign up for the alerts and warnings that cover where you live, and learn about local hazards.', href: 'https://beready.campaign.gov.uk/be-ready-for-emergencies/alerts-and-warnings/', link: 'Alerts and warnings' },
  { icon: 'map-pinned', title: 'Your flood risk', text: 'Check the long-term flood risk for your address, using the service for your nation.', href: 'https://www.gov.uk/check-long-term-flood-risk', link: 'Check flood risk (England)' },
];
const otherSteps = [
  'Add to your supplies gradually during your normal shopping.',
  'Check expiry dates every six months.',
  'Agree escape routes and a meeting point as a household.',
  'Know how to turn off your gas, electricity and water.',
  'Check your home insurance covers what you need.',
  'Swap numbers with neighbours and plan to check on anyone who may need help.',
];
const carKit = ['A torch', 'An in-car phone charger', 'Warm clothes and blankets', 'High-visibility clothing', 'Jump leads', 'Food and drink', 'A snow shovel', 'A first aid kit'];
---
<BaseLayout
  title="Why prepare? What the UK government says you should be ready for"
  description="The UK government asks households to be ready to cope for 3 days. Here are the situations it names, its home checklist, and the free sign-ups worth doing."
  breadcrumbs={[{ label: 'Guides', href: '/guides/' }, { label: 'Why prepare?' }]}
>
  <div class="tone-gov">
    <div class="wrap">
      <header class="page-head page-head-tone">
        <div>
          <h1>Why prepare? What the UK government says you should be ready for</h1>
          <p>Power cuts, floods and storms are ordinary events, and a little preparation makes them much easier to cope with. The government asks every household to be ready to cope on its own for <strong>3 days</strong>, so help can reach the people who need it most.</p>
          <p class="why-meta muted text-sm"><Icon name="calendar-check" size={18} /> Checked against GOV.UK on <time datetime={isoDate(reviewed)}>{formatDate(reviewed)}</time></p>
        </div>
        <div class="page-head-art"><Illustration name="severe-weather" width={190} /></div>
      </header>
    </div>

    <section class="band" aria-labelledby="risks-title">
      <div class="wrap">
        <div class="band-head">
          <div>
            <h2 id="risks-title">The situations it names</h2>
            <p>What each looks like, and one first step.</p>
          </div>
        </div>
        <ul class="card-grid card-grid-wide">
          {RISKS.map((r) => (
            <li id={r.id} class={`card is-link risk-card tone-${r.tone}`}>
              {r.art ? <span class="card-art"><Illustration name={r.art} width={128} /></span> : <span class="chip chip-lg"><Icon name={r.icon} size={28} /></span>}
              <h3 class="card-title"><a href={r.href} class="stretched">{r.title}</a></h3>
              <p class="card-text">{r.looks}</p>
              <p class="risk-first"><Icon name="footprints" size={18} /><span><strong>First step:</strong> {r.first}</span></p>
              <span class="card-cta" aria-hidden="true">{r.linkLabel} <Icon name="arrow-right" size={18} /></span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="band-plain" aria-labelledby="checklist-title">
      <div class="wrap checklist-grid">
        <div>
          <h2 id="checklist-title">The government's 3-day checklist</h2>
          <p class="mt-2 muted">What the Be Ready campaign suggests keeping at home. Our free calculators do the sums for the first two.</p>
          <div class="card is-link tone-water mt-6">
            <span class="card-art"><Illustration name="water-storage" width={120} /></span>
            <h3 class="card-title"><a href="/tools/water-storage-calculator/" class="stretched">Start with water</a></h3>
            <p class="card-text">Work out how much your household needs for 3 days.</p>
            <span class="card-cta" aria-hidden="true">Water calculator <Icon name="arrow-right" size={18} /></span>
          </div>
        </div>
        <ul class="tick-list checklist">
          {BE_READY_CHECKLIST.map((c) => (
            <li>
              <span class="tick-ico" aria-hidden="true"><Icon name="check" size={16} strokeWidth={3} /></span>
              <span>
                {c.item}
                {c.note && <span class="tick-note">{c.note}</span>}
                {c.href && <a href={c.href} class="tick-link">{c.link}</a>}
                {c.extra && <a href={c.extra.href} class="tick-link">{c.extra.link}</a>}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="band" aria-labelledby="signup-title">
      <div class="wrap">
        <div class="band-head"><h2 id="signup-title">Sign up and find out</h2></div>
        <ul class="card-grid">
          {signUps.map((s) => (
            <li class="card is-link">
              <span class="chip"><Icon name={s.icon} size={22} /></span>
              <h3 class="card-title"><a href={s.href} class="stretched" rel={s.href.startsWith('http') ? 'noopener' : undefined}>{s.title}</a></h3>
              <p class="card-text">{s.text}</p>
              <span class="card-cta" aria-hidden="true">{s.link} <Icon name={s.href.startsWith('http') ? 'external-link' : 'arrow-right'} size={18} /></span>
            </li>
          ))}
        </ul>
        <p class="mt-6"><a href="/local-risk/" class="btn btn-secondary"><Icon name="map-pin" size={18} /> Check the risks for your postcode</a></p>
        <details class="disclosure mt-6">
          <summary><Icon name="list-checks" size={20} /> Other steps the government recommends</summary>
          <div class="disclosure-body">
            <ul class="tick-list">
              {otherSteps.map((s) => (
                <li><span class="tick-ico" aria-hidden="true"><Icon name="check" size={16} strokeWidth={3} /></span><span>{s}</span></li>
              ))}
            </ul>
            <p class="text-sm muted">Flood risk checks for <a href="https://naturalresources.wales/flooding/check-your-flood-risk-by-postcode/?lang=en" rel="noopener">Wales</a>, <a href="https://beta.sepa.scot/flooding/flood-maps/" rel="noopener">Scotland</a> and <a href="https://www.nidirect.gov.uk/articles/check-risk-flooding-your-area" rel="noopener">Northern Ireland</a>.</p>
          </div>
        </details>
        <details class="disclosure mt-3" id="car-kit">
          <summary><Icon name="car-front" size={20} /> Getting your car ready for winter</summary>
          <div class="disclosure-body">
            <p>For journeys in wintry weather, the government suggests carrying:</p>
            <ul class="tick-list">
              {carKit.map((s) => (
                <li><span class="tick-ico" aria-hidden="true"><Icon name="check" size={16} strokeWidth={3} /></span><span>{s}</span></li>
              ))}
            </ul>
          </div>
        </details>
      </div>
    </section>

    <section class="band-plain" aria-labelledby="sources-title">
      <div class="wrap">
        <div class="sources-box">
          <h2 id="sources-title"><Icon name="landmark" size={20} /> Sources</h2>
          <ul>
            <li><a href={BE_READY_URL} rel="noopener">Be ready for emergencies</a> (UK Government, Be Ready campaign). The household advice, checklist and situations on this page.</li>
            <li><a href={NRR_URL} rel="noopener">National Risk Register 2025</a> (Cabinet Office, published 16 January 2025). The public version of the government's National Security Risk Assessment: its view of the most serious risks facing the UK and how likely and serious each could be.</li>
          </ul>
          <p class="mt-3 text-sm muted">This page summarises government advice in our own words. In an emergency, follow instructions from the emergency services and official sources.</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
<script>
  import { progress } from '../lib/progress';
  progress().markSeen('why-prepare');
</script>

<style>
  .why-meta { display: inline-flex; gap: 0.4rem; align-items: center; margin-top: 0.9rem !important; font-size: 0.9rem !important; }
  .risk-card .card-art { margin-bottom: 0.1rem; }
  .risk-first {
    display: grid; grid-template-columns: 1.1rem 1fr; gap: 0.5rem; align-items: start;
    margin-top: 0.3rem; padding: 0.6rem 0.75rem; border-radius: 0.9rem;
    background: var(--t-band); font-size: 0.95rem;
  }
  .risk-first :global(.icon) { margin-top: 0.2rem; color: var(--t-ink); }
  .checklist-grid { display: grid; gap: 2rem; }
  @media (min-width: 900px) { .checklist-grid { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr); gap: 3.5rem; align-items: start; } }
  .checklist { position: relative; z-index: 1; }
  .tick-link { display: inline-block; margin-top: 0.15rem; font-size: 0.93rem; }
  .sources-box h2 { display: flex; gap: 0.5rem; align-items: center; }
</style>
