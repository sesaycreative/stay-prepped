---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';
const publicEmail = (import.meta.env.PUBLIC_CONTACT_EMAIL as string | undefined) || SITE.contactEmail;
---
<BaseLayout title="Contact us" description="Get in touch with Stay Prepped about a guide, a tool or a correction." breadcrumbs={[{ label: 'Contact' }]}>
  <div class="wrap">
    <header class="py-6 measure">
      <h1>Contact us</h1>
      <p class="mt-3 text-lg">Spotted a mistake, have an idea for a tool, or a question about a guide? Send us a message.</p>
      <p class="mt-2 muted">We cannot give personal medical, legal or financial advice. In an emergency, call 999.</p>
    </header>
    <div class="grid gap-10 lg:grid-cols-[minmax(0,34rem)_1fr]">
      <form class="panel grid gap-5" method="post" action="/api/contact" data-contact novalidate>
        <div class="field">
          <label class="field-label" for="c-name">Your name</label>
          <input class="input" id="c-name" name="name" autocomplete="name" required maxlength="100" aria-describedby="c-name-err" />
          <span class="field-error" id="c-name-err" data-err="name"></span>
        </div>
        <div class="field">
          <label class="field-label" for="c-email">Email address</label>
          <span class="field-help" id="c-email-help">So we can reply. We will not add you to any list.</span>
          <input class="input" id="c-email" name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="c-email-help c-email-err" />
          <span class="field-error" id="c-email-err" data-err="email"></span>
        </div>
        <div class="field">
          <label class="field-label" for="c-message">Message</label>
          <textarea class="textarea" id="c-message" name="message" rows="7" required minlength="10" maxlength="5000" aria-describedby="c-message-err"></textarea>
          <span class="field-error" id="c-message-err" data-err="message"></span>
        </div>
        <div class="sr-only" aria-hidden="true">
          <label for="c-website">Leave this field empty</label>
          <input id="c-website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <div>
          <button type="submit" class="btn btn-primary">Send message</button>
        </div>
        <p class="field-help" role="status" aria-live="polite" data-status></p>
        <p class="field-help">We use your details only to reply. See our <a href="/privacy/">privacy policy</a>.</p>
      </form>
      <aside class="measure">
        <h2 class="text-xl">Prefer email?</h2>
        {publicEmail ? (
          <p class="mt-2">Email us at <a href={`mailto:${publicEmail}`}>{publicEmail}</a>.</p>
        ) : (
          <p class="mt-2">If the form is not working, it may not be switched on yet. Please try again later.</p>
        )}
      </aside>
    </div>
  </div>
</BaseLayout>
<script define:vars={{ publicEmail: publicEmail ?? '' }}>
  const form = document.querySelector('form[data-contact]');
  if (form) {
    const status = form.querySelector('[data-status]');
    const setErr = (field, msg) => {
      const el = form.querySelector(`[data-err="${field}"]`);
      const input = form.querySelector(`[name="${field}"]`);
      if (el) el.textContent = msg || '';
      if (input) msg ? input.setAttribute('aria-invalid', 'true') : input.removeAttribute('aria-invalid');
    };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      ['name', 'email', 'message'].forEach((f) => setErr(f, ''));
      const fd = new FormData(form);
      const errs = {};
      if (!String(fd.get('name') || '').trim()) errs.name = 'Enter your name.';
      const email = form.querySelector('[name="email"]');
      if (!String(fd.get('email') || '').trim() || !email.checkValidity()) errs.email = 'Enter a valid email address, like name@example.com.';
      if (String(fd.get('message') || '').trim().length < 10) errs.message = 'Your message must be at least 10 characters.';
      if (Object.keys(errs).length) {
        Object.entries(errs).forEach(([k, v]) => setErr(k, v));
        form.querySelector('[aria-invalid="true"]')?.focus();
        status.textContent = 'Please fix the highlighted fields.';
        return;
      }
      const btn = form.querySelector('button[type="submit"]');
      btn.disabled = true;
      status.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: fd, headers: { Accept: 'application/json' } });
        const data = await res.json().catch(() => ({}));
        if (data.errors) Object.entries(data.errors).forEach(([k, v]) => setErr(k, v));
        if (data.notConfigured && publicEmail) {
          const subject = encodeURIComponent('Message from the Stay Prepped website');
          const body = encodeURIComponent(`${fd.get('message')}\n\n${fd.get('name')}`);
          status.innerHTML = '';
          status.append('Our contact form is not live yet. ');
          const a = document.createElement('a');
          a.href = `mailto:${publicEmail}?subject=${subject}&body=${body}`;
          a.textContent = 'Open your email app with this message';
          status.append(a);
        } else {
          status.textContent = data.message || (res.ok ? 'Sent.' : 'Sending failed. Please try again later.');
        }
        if (res.ok && data.ok) form.reset();
      } catch {
        status.textContent = 'We could not reach the server. Check your connection and try again.';
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>
