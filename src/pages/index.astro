---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Contours from '../components/Contours.astro';
import ToolCard from '../components/ToolCard.astro';
import GuideCard from '../components/GuideCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import Icon from '../components/Icon.astro';
import Illustration from '../components/illustrations/Illustration.astro';
import { RISKS } from '../data/risks';
import { GUIDE_HUBS, SITE, type IllustrationKey, type Tone } from '../lib/site';

const tools = (await getCollection('tools')).sort((a, b) => a.data.order - b.data.order);
const live = tools.filter((t) => t.data.status === 'live');
const guides = await getCollection('guides');
const popularOrder = ['how-much-water-to-store', 'how-much-food-to-store', '72-hour-emergency-bag', 'preparing-for-a-power-cut'];
const popular = popularOrder.map((s) => guides.find((g) => g.id === s)).filter((g) => g !== undefined);
const gear = await getCollection('gear');

const hubBlurbs: Record<string, { blurb: string; art?: IllustrationKey }> = {
  '/food-water/': { blurb: 'How much to store and how to keep it fresh.', art: 'food-cupboard' },
  '/emergency-kits/': { blurb: 'Grab bags and home supplies.', art: 'grab-bag' },
  '/guides/category/power-outages/': { blurb: 'Light, warmth and news when the power goes.', art: 'power-cut' },
  '/family-home/': { blurb: 'Household plans and important papers.', art: 'family-plan' },
  '/survival-skills/': { blurb: 'Coping calmly when services stop.' },
};
const hubs = GUIDE_HUBS.filter((h) => h.href in hubBlurbs);

// The 8 areas of preparedness, shown as the hero grid.
const areas: { title: string; text: string; href: string; tone: Tone; art: IllustrationKey }[] = [
  { title: 'Water', text: '3 days of drinking water, stored and rotated', href: '/guides/how-much-water-to-store/', tone: 'water', art: 'water-storage' },
  { title: 'Food', text: 'A cupboard that feeds everyone without power', href: '/food-water/', tone: 'food', art: 'food-cupboard' },
  { title: 'Emergency bag', text: 'A grab bag ready by the door', href: '/emergency-kits/', tone: 'kits', art: 'grab-bag' },
  { title: 'Power cuts', text: 'Light, warmth and a charged phone', href: '/guides/category/power-outages/', tone: 'power', art: 'power-cut' },
  // No first aid guides yet, so the category page is not built; link to the
  // first aid section of the beginners guide until one exists.
  { title: 'First aid & medicine', text: 'A kit, your prescriptions, basic skills', href: '/guides/prepping-for-beginners/#8-check-your-first-aid-kit-and-medicines', tone: 'health', art: 'first-aid' },
  { title: 'Family plan', text: 'Who calls whom, where you meet', href: '/family-home/', tone: 'home', art: 'family-plan' },
  { title: 'Home & documents', text: 'Alarms, shut-offs, copies of what matters', href: '/guides/category/home/', tone: 'docs', art: 'home-safety' },
  { title: 'Severe weather & flooding', text: 'Know your local risk and what to do', href: '/why-prepare/', tone: 'gov', art: 'flood' },
];
const teaseRisks = RISKS.filter((r) => r.art).slice(0, 4);
---
<BaseLayout title={SITE.name} description="Emergency preparedness made practical for UK households: free prepper tools, calculators for your emergency food supply and water storage, grab-bag checklists and plain-English guides to get ready.">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-contours" aria-hidden="true"><Contours rings={14} /></div>
    <div class="wrap hero-inner">
      <div class="hero-top">
        <h1 id="hero-title" class="hero-title">
          <span>Be Prepared.</span>
          <span>Stay Ready.</span>
          <span>Protect What Matters.</span>
        </h1>
        <div class="hero-side">
          <p class="hero-sub">Free tools, checklists and plain-English guides to get your home ready for 3 days.</p>
          <div class="hero-ctas">
            <a href="/start/" class="btn btn-primary">Start Prepping</a>
            <a href="/tools/" class="btn btn-ghost">Explore Free Tools</a>
          </div>
        </div>
      </div>
      <h2 class="sr-only">The 8 areas of preparedness</h2>
      <ul class="areas">
        {areas.map((a) => (
          <li class={`card is-link area tone-${a.tone}`}>
            <span class="area-art"><Illustration name={a.art} width={96} /></span>
            <span class="area-body">
              <h3 class="area-title"><a href={a.href} class="stretched">{a.title}</a></h3>
              <p class="area-text">{a.text}</p>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band tone-gov" aria-labelledby="why-title">
    <div class="wrap">
      <div class="band-head">
        <div>
          <h2 id="why-title">What the government says to prepare for</h2>
          <p>Be ready to cope on your own for 3 days.</p>
        </div>
        <a href="/why-prepare/" class="band-more">All situations and the checklist</a>
      </div>
      <ul class="card-grid">
        {teaseRisks.map((r) => (
          <li class={`card is-link tone-${r.tone}`}>
            <span class="card-art"><Illustration name={r.art!} width={128} /></span>
            <h3 class="card-title"><a href={r.href} class="stretched">{r.title}</a></h3>
            <p class="card-text">{r.looks}</p>
            <span class="card-cta" aria-hidden="true">{r.linkLabel} <Icon name="arrow-right" size={18} /></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band-plain" aria-labelledby="free-tools">
    <div class="wrap">
      <div class="band-head">
        <div>
          <h2 id="free-tools">Free prepper tools</h2>
          <p>They do the sums. Nothing leaves your device.</p>
        </div>
        <a href="/tools/" class="band-more">All {tools.length} tools</a>
      </div>
      <div class="card-grid card-grid-fit">
        {live.map((t) => <ToolCard tool={t} art />)}
      </div>
    </div>
  </section>

  <section class="band tone-neutral" aria-labelledby="categories">
    <div class="wrap">
      <div class="band-head">
        <div>
          <h2 id="categories">Find your topic</h2>
          <p>Each area has its own colour, here and across the site.</p>
        </div>
        <a href="/guides/" class="band-more">All guides</a>
      </div>
      <div class="card-grid hub-grid">
        {hubs.map((h) => (
          <CategoryCard href={h.href} label={h.label} icon={h.icon} tone={h.tone} blurb={hubBlurbs[h.href].blurb} art={hubBlurbs[h.href].art} />
        ))}
      </div>
    </div>
  </section>

  <section class="band-plain" aria-labelledby="popular-guides">
    <div class="wrap">
      <div class="band-head">
        <div>
          <h2 id="popular-guides">Popular guides</h2>
          <p>Start with the questions most people ask.</p>
        </div>
      </div>
      <div class="card-grid">
        {popular.map((g) => <GuideCard guide={g} art={false} />)}
      </div>
    </div>
  </section>

  <div class="band tone-neutral">
    <div class="wrap home-split">
      <NewsletterForm />
      {gear.length > 0 && (
        <section class="tone-kits" aria-labelledby="gear-guides">
          <h2 id="gear-guides" class="text-xl">Gear buying guides</h2>
          <p class="muted mt-1">What to look for, with no sponsored picks.</p>
          <ul class="mt-4 grid gap-3">
            {gear.map((g) => (
              <li class="card is-link gear-card">
                <span class="chip"><Icon name="shopping-bag" size={22} /></span>
                <a href={`/gear/${g.id}/`} class="stretched gear-link">{g.data.title}</a>
              </li>
            ))}
          </ul>
          <p class="mt-3"><a href="/gear/" class="font-bold">All buying guides</a></p>
        </section>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .hero { position: relative; overflow: hidden; }
  .hero-contours { position: absolute; inset: 0 0 0 30%; opacity: 0.9; pointer-events: none; }
  .hero-inner { position: relative; padding-block: 2rem 2.5rem; }
  .hero-top { display: grid; gap: 1.1rem; }
  .hero-title { font-size: clamp(2rem, 1.2rem + 3.4vw, 3.1rem); font-weight: 800; line-height: 1.08; letter-spacing: -0.03em; }
  .hero-title span { display: block; }
  .hero-title span:last-child { color: var(--primary); }
  .hero-sub { font-size: 1.15rem; max-width: 30rem; }
  .hero-ctas { margin-top: 1.1rem; display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .hero-ctas .btn { min-height: 3rem; padding-inline: 1.35rem; font-size: 1.05rem; }
  @media (min-width: 960px) {
    .hero-inner { padding-block: 2.25rem 2.75rem; }
    .hero-top { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); align-items: end; column-gap: 3rem; }
    .hero-title span:nth-child(-n + 2) { display: inline; }
    .hero-side { padding-bottom: 0.2rem; }
  }

  .areas { margin-top: 1.75rem; display: grid; gap: 0.75rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 960px) { .areas { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; } }
  .area { padding: 0.85rem; gap: 0.5rem; border-radius: 1.25rem; }
  @supports (corner-shape: squircle) { .area { border-radius: 2.25rem; } }
  .area-art :global(.ill) { width: 4.5rem; --ill-bg: var(--t-band); }
  .area-body { display: grid; gap: 0.15rem; }
  .area-title { font-size: 0.98rem; line-height: 1.25; overflow-wrap: anywhere; hyphens: auto; }
  .area-title a { color: var(--heading); text-decoration: none; }
  .area:hover .area-title a { text-decoration: underline; text-decoration-thickness: 2px; }
  .area-text { font-size: 0.9rem; line-height: 1.4; color: var(--text-muted); }
  @media (min-width: 640px) {
    .area { flex-direction: row; align-items: center; gap: 0.85rem; padding: 0.9rem 1rem; }
    .area-art { flex-shrink: 0; }
    .area-art :global(.ill) { width: 5.25rem; }
    .area-title { font-size: 1.02rem; }
  }

  .hub-grid { grid-template-columns: repeat(auto-fit, minmax(min(100%, 12.5rem), 1fr)); }

  @media (min-width: 860px) {
      }

  .home-split { display: grid; gap: 3rem; }
  @media (min-width: 960px) { .home-split { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); align-items: start; } }
  .gear-card { flex-direction: row; align-items: center; gap: 0.85rem; padding: 0.9rem 1.1rem; }
  .gear-link { font-weight: 700; color: var(--heading); text-decoration: none; }
  .gear-card:hover .gear-link { text-decoration: underline; }
</style>
