---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { CHECKLISTS, OFFICIAL_LINKS } from '../../data/checklists';
---
<BaseLayout
  title="Printable checklists and official links"
  description="Free printable emergency checklists for your home, grab bag, power cuts and documents, plus links to official UK emergency-preparedness advice."
  breadcrumbs={[{ label: 'Resources' }]}
>
  <div class="wrap">
    <header class="page-head">
      <h1>Resources</h1>
      <p>Printable checklists for the fridge or grab bag, and the official sources we rely on.</p>
    </header>
  </div>

  <section aria-labelledby="checklists-title" class="band tone-kits">
    <div class="wrap">
      <div class="band-head">
        <div>
          <h2 id="checklists-title">Printable checklists</h2>
          <p>Our <a href="/tools/">free tools</a> also make lists tailored to your household.</p>
        </div>
      </div>
      <ul class="card-grid">
        {CHECKLISTS.map((c) => (
          <li class="card is-link">
            <span class="chip"><Icon name="printer" size={22} /></span>
            <h3 class="card-title"><a href={`/resources/checklists/${c.slug}/`} class="stretched">{c.title}</a></h3>
            <p class="card-text">{c.description}</p>
            <span class="card-cta" aria-hidden="true">Open and print <Icon name="arrow-right" size={18} /></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section aria-labelledby="official-title" class="band-plain tone-gov">
    <div class="wrap">
      <div class="band-head">
        <div>
          <h2 id="official-title">Official advice</h2>
          <p>In an emergency, follow the emergency services and official sources first.</p>
        </div>
        <a href="/why-prepare/" class="band-more">What the government says to prepare for</a>
      </div>
      <ul class="card-grid">
        {OFFICIAL_LINKS.map((l) => (
          <li class="card is-link official">
            <p class="card-label"><Icon name="landmark" size={16} /> {l.publisher}</p>
            <h3 class="card-title"><a href={l.url} rel="noopener" class="stretched">{l.title}</a></h3>
            <p class="card-text">{l.note}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section aria-labelledby="numbers-title" class="band tone-power">
    <div class="wrap">
      <h2 id="numbers-title">Numbers to know (UK)</h2>
      <dl class="numbers mt-5">
        <div class="card"><dt>999</dt><dd>Emergency services when life is at risk.</dd></div>
        <div class="card"><dt>111</dt><dd>NHS 111 for urgent medical help that is not an emergency.</dd></div>
        <div class="card"><dt>105</dt><dd>Report a power cut (England, Scotland and Wales).</dd></div>
      </dl>
    </div>
  </section>
</BaseLayout>
<style>
  .numbers { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); }
  .numbers dt { font-family: var(--font-head); font-weight: 700; font-size: 2.2rem; line-height: 1; color: var(--heading); }
  .numbers dd { color: var(--text-muted); }
</style>
