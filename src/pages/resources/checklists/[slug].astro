---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PrintButton from '../../../components/PrintButton.astro';
import { CHECKLISTS, type Checklist } from '../../../data/checklists';
export function getStaticPaths() {
  return CHECKLISTS.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
interface Props { c: Checklist }
const { c } = Astro.props;
---
<BaseLayout title={c.title} description={c.description} breadcrumbs={[{ label: 'Resources', href: '/resources/' }, { label: c.title }]}>
  <div class="wrap">
    <header class="py-6 measure">
      <h1>{c.title}</h1>
      <p class="mt-3 text-lg">{c.intro}</p>
      <div class="mt-4 no-print"><PrintButton label="Print this checklist" /></div>
    </header>
    <div class="grid gap-8 md:grid-cols-2 measure-wide">
      {c.sections.map((s, si) => (
        <section aria-labelledby={`s-${si}`} class="panel">
          <h2 id={`s-${si}`} class="text-xl">{s.heading}</h2>
          <ul class="mt-2">
            {s.items.map((item, ii) => (
              <li class="check-item">
                <input type="checkbox" id={`c-${si}-${ii}`} />
                <label for={`c-${si}-${ii}`}>{item}</label>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
    <p class="mt-8 no-print">Read the full guide: <a href={c.relatedGuide.href}>{c.relatedGuide.label}</a>. Ticks on this page are not saved.</p>
    <p class="mt-6 print-only text-sm">From Stay Prepped. General guidance only; follow official advice in an emergency. In an emergency where life is at risk, call 999.</p>
  </div>
</BaseLayout>
<style>
  .measure-wide { max-width: 60rem; }
</style>
