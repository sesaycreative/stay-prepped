---
// Everything the site remembers about this visitor, read from their own
// browser. The server-rendered page is the empty state; a small script fills
// it in. Nothing here is sent anywhere.
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { AREAS } from '../lib/progress';
---
<BaseLayout
  title="My progress"
  description="Your preparedness progress on Stay Prepped: the eight areas, your household and your checklists. Stored only in this browser."
  breadcrumbs={[{ label: 'My progress' }]}
  noindex
  searchable={false}
>
  <div class="wrap">
    <header class="page-head">
      <h1>My progress</h1>
      <p>What this browser remembers about your preparations. It is stored only on this device and never sent to us.</p>
    </header>

    <section class="mp-summary card tone-neutral" aria-labelledby="mp-sum-title">
      <h2 id="mp-sum-title" class="sr-only">Summary</h2>
      <p class="mp-big"><span data-mp-done>0</span> of {AREAS.length} areas ready</p>
      <p class="muted" data-mp-next>Pick any area below to start.</p>
    </section>

    <section class="mt-10" aria-labelledby="mp-areas-title">
      <h2 id="mp-areas-title">The eight areas</h2>
      <p class="muted mt-1">Each area is marked ready automatically when you do the thing in its description.</p>
      <ul class="mp-areas card-grid mt-4">
        {AREAS.map((a) => (
          <li class={`card mp-area tone-${a.tone}`} data-mp-area={a.id}>
            <div class="mp-area-head">
              <span class="mp-status" data-mp-status aria-hidden="true"></span>
              <h3 class="card-title"><a href={a.href}>{a.label}</a></h3>
            </div>
            <p class="card-text">{a.rule}</p>
            <p class="mp-state" data-mp-state>Not yet</p>
          </li>
        ))}
      </ul>
    </section>

    <div class="mp-two mt-10">
      <section aria-labelledby="mp-hh-title" class="card tone-neutral">
        <h2 id="mp-hh-title" class="text-xl">Your household</h2>
        <p class="mt-2" data-mp-household>Not set. <a href="/#who-at-home">Tell us who is at home</a> and the homepage and calculators will size everything for you.</p>
        <p class="mt-2 text-sm muted" data-mp-outward hidden></p>
      </section>
      <section aria-labelledby="mp-lists-title" class="card tone-neutral">
        <h2 id="mp-lists-title" class="text-xl">Checklists you have started</h2>
        <ul class="mp-lists mt-2" data-mp-lists></ul>
        <p class="mt-2 muted" data-mp-lists-empty>None yet. Checklists in the guides, the printable resources and the food calculator save your ticks here.</p>
      </section>
    </div>

    <section class="mp-clear mt-10" aria-labelledby="mp-clear-title">
      <h2 id="mp-clear-title" class="text-xl">Clear everything on this device</h2>
      <p class="mt-1 muted">Removes your household, ticks, calculator inputs and area progress from this browser. Your light or dark theme choice is kept.</p>
      <div class="mt-3" data-mp-clear-step="1">
        <button type="button" class="btn btn-ghost" data-mp-clear><Icon name="eraser" size={18} /> Clear everything on this device</button>
      </div>
      <div class="mp-confirm mt-3" data-mp-clear-step="2" hidden>
        <p class="font-bold" id="mp-confirm-q">This cannot be undone. Clear everything?</p>
        <div class="mt-2 flex flex-wrap gap-2" role="group" aria-labelledby="mp-confirm-q">
          <button type="button" class="btn btn-primary" data-mp-clear-yes>Yes, clear everything</button>
          <button type="button" class="btn btn-ghost" data-mp-clear-no>Keep my progress</button>
        </div>
      </div>
      <p class="mt-3" role="status" aria-live="polite" data-mp-cleared></p>
    </section>
  </div>
</BaseLayout>

<script>
  import { AREAS, doneCount, nextArea, progress } from '../lib/progress';
  const store = progress();
  const $ = <T extends Element>(s: string) => document.querySelector<T>(s);

  function render() {
    const s = store.get();
    const done = doneCount(s);
    $('[data-mp-done]')!.textContent = String(done);
    const next = nextArea(s);
    const nextEl = $<HTMLElement>('[data-mp-next]')!;
    nextEl.textContent = '';
    if (next) {
      nextEl.append('Next: ');
      const a = document.createElement('a');
      a.href = next.href;
      a.textContent = next.label;
      nextEl.append(a);
    } else nextEl.textContent = 'All eight areas are ready. Check them again in six months.';

    for (const a of AREAS) {
      const card = $<HTMLElement>(`[data-mp-area="${a.id}"]`)!;
      const st = s.areas[a.id];
      card.classList.toggle('is-done', !!st);
      const state = card.querySelector('[data-mp-state]')!;
      state.textContent = st ? `Ready since ${new Date(st.at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}` : 'Not yet';
    }

    const h = s.household;
    const hh = $<HTMLElement>('[data-mp-household]')!;
    if (h.set) {
      const parts = [`${h.adults} ${h.adults === 1 ? 'adult' : 'adults'}`, `${h.children} ${h.children === 1 ? 'child' : 'children'} under 12`];
      const pets = h.pets.dogs + h.pets.cats;
      if (pets) parts.push(`${h.pets.dogs} ${h.pets.dogs === 1 ? 'dog' : 'dogs'}, ${h.pets.cats} ${h.pets.cats === 1 ? 'cat' : 'cats'}`);
      hh.textContent = parts.join(', ') + '. ';
      const edit = document.createElement('a');
      edit.href = '/#who-at-home';
      edit.textContent = 'Change';
      hh.append(edit);
    }
    const ow = $<HTMLElement>('[data-mp-outward]')!;
    ow.hidden = !s.localRisk.outward;
    if (s.localRisk.outward) ow.textContent = `Local area saved: ${s.localRisk.outward} (the first part of your postcode only).`;

    const ul = $<HTMLElement>('[data-mp-lists]')!;
    ul.textContent = '';
    const started = Object.entries(s.lists).filter(([id]) => (s.checklists[id]?.length ?? 0) > 0);
    for (const [id, meta] of started) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = meta.href;
      a.textContent = meta.title;
      const n = Math.min(meta.total, s.checklists[id]?.length ?? 0);
      const chip = document.createElement('span');
      chip.className = 'mp-chip';
      chip.textContent = n >= meta.total ? 'Complete' : `${n} of ${meta.total}`;
      li.append(a, ' ', chip);
      ul.append(li);
    }
    $<HTMLElement>('[data-mp-lists-empty]')!.hidden = started.length > 0;
  }

  const step1 = $<HTMLElement>('[data-mp-clear-step="1"]')!;
  const step2 = $<HTMLElement>('[data-mp-clear-step="2"]')!;
  $('[data-mp-clear]')!.addEventListener('click', () => {
    step1.hidden = true;
    step2.hidden = false;
    $<HTMLButtonElement>('[data-mp-clear-no]')!.focus();
  });
  $('[data-mp-clear-no]')!.addEventListener('click', () => {
    step2.hidden = true;
    step1.hidden = false;
    $<HTMLButtonElement>('[data-mp-clear]')!.focus();
  });
  $('[data-mp-clear-yes]')!.addEventListener('click', () => {
    store.clearAll();
    step2.hidden = true;
    step1.hidden = false;
    $('[data-mp-cleared]')!.textContent = 'Everything has been cleared from this device.';
    $<HTMLButtonElement>('[data-mp-clear]')!.focus();
  });
  store.subscribe(render);
  render();
</script>

<style>
  .mp-summary { flex-direction: row; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 1.5rem; height: auto; }
  .mp-big { font-family: var(--font-head); font-weight: 800; font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.1rem); color: var(--heading); }
  .mp-area-head { display: flex; gap: 0.6rem; align-items: center; }
  .mp-status { width: 1.6rem; height: 1.6rem; border-radius: 999px; border: 2px solid var(--t-strong); flex-shrink: 0; display: grid; place-items: center; }
  .mp-area.is-done .mp-status { background: var(--t-strong); }
  .mp-area.is-done .mp-status::after { content: ''; width: 0.7rem; height: 0.4rem; border-left: 2.5px solid var(--surface); border-bottom: 2.5px solid var(--surface); transform: translateY(-1px) rotate(-45deg); }
  .mp-state { margin-top: auto; padding-top: 0.4rem; font-weight: 700; font-size: 0.9rem; color: var(--text-muted); }
  .mp-area.is-done .mp-state { color: var(--t-ink); }
  .mp-two { display: grid; gap: 1.25rem; }
  @media (min-width: 900px) { .mp-two { grid-template-columns: 1fr 1fr; } }
  .mp-two .card { height: auto; }
  .mp-lists { display: grid; gap: 0.5rem; }
  .mp-lists :global(li) { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .mp-lists :global(.mp-chip) { font-size: 0.8rem; font-weight: 700; padding: 0.05rem 0.55rem; border-radius: 999px; border: 1px solid var(--rule-strong); color: var(--text-muted); }
  .mp-clear { max-width: 44rem; padding-top: 1.5rem; border-top: 1px solid var(--rule); }
</style>
