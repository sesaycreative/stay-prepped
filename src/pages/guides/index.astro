---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideCard from '../../components/GuideCard.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import { GUIDE_CATEGORIES, GUIDE_CATEGORY_KEYS, GUIDE_HUBS } from '../../lib/site';

const guides = (await getCollection('guides')).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime() || a.data.title.localeCompare(b.data.title));
const counts = Object.fromEntries(GUIDE_CATEGORY_KEYS.map((k) => [k, guides.filter((g) => g.data.category === k).length]));
const withoutGuides = GUIDE_CATEGORY_KEYS.filter((k) => counts[k] === 0);
const hubs = GUIDE_HUBS.filter((h) => h.href !== '/guides/');
const hubBlurb: Record<string, string> = {
  '/food-water/': 'Storing, rotating and treating.',
  '/emergency-kits/': 'Grab bags and home kits.',
  '/guides/category/power-outages/': GUIDE_CATEGORIES['power-outages'].blurb,
  '/family-home/': 'Plans, papers and your home.',
  '/survival-skills/': 'Coping when services stop.',
  '/why-prepare/': 'What the government asks of us.',
};
---
<BaseLayout
  title="Emergency preparedness guides"
  description="Practical, UK-focused guides to emergency preparedness: water, food, grab bags, power cuts, family plans and essential documents."
  breadcrumbs={[{ label: 'Guides' }]}
>
  <div class="wrap">
    <header class="page-head">
      <h1>Guides</h1>
      <p>Plain-English guides to getting your household ready, one topic at a time.</p>
    </header>
    <nav aria-labelledby="topics-title">
      <h2 id="topics-title" class="sr-only">Topics</h2>
      <div class="card-grid topic-grid">
        {hubs.map((h) => <CategoryCard href={h.href} label={h.label} icon={h.icon} tone={h.tone} blurb={hubBlurb[h.href] ?? ''} compact />)}
      </div>
    </nav>
  </div>
  <section class="band tone-neutral mt-10" aria-labelledby="all-guides">
    <div class="wrap">
      <div class="band-head"><h2 id="all-guides">All guides</h2></div>
      <div class="card-grid">
        {guides.map((g) => <GuideCard guide={g} />)}
      </div>
      {withoutGuides.length > 0 && (
        <p class="mt-6 text-sm muted">Guides on {withoutGuides.map((k) => GUIDE_CATEGORIES[k].label.toLowerCase()).join(', ')} are being written.</p>
      )}
    </div>
  </section>
</BaseLayout>
<style>
  .topic-grid { grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); gap: 0.75rem; }
</style>
